# La etapa de compilacion corre en la arquitectura del runner (BUILDPLATFORM) y
# cross-compila al destino con GOOS/GOARCH, en vez de emular el toolchain con
# QEMU para cada plataforma.
FROM --platform=$BUILDPLATFORM golang:1.25 AS builder

# OJO: se redeclaran SIN valor por defecto a proposito. BuildKit define TARGETOS
# y TARGETARCH en el ambito global y solo los inyecta en la etapa si se
# redeclaran vacios; con un valor por defecto gana ese valor y la inyeccion no
# ocurre.
#
# Con `ARG TARGETARCH=amd64` el workflow construia las dos plataformas que pide
# `platforms: linux/amd64,linux/arm64`, pero ambas compilaban con GOARCH=amd64.
# La imagen publicaba un manifest con arm64 que dentro llevaba un binario x86_64,
# y el contenedor moria en nodos ARM con "exec format error".
ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags "-s -w" -o /elasticsearch_exporter .

FROM gcr.io/distroless/static-debian12:nonroot
LABEL io.prometheus.image.variant="ghcr"
COPY --from=builder /elasticsearch_exporter /bin/elasticsearch_exporter
EXPOSE 9114
USER nonroot
ENTRYPOINT ["/bin/elasticsearch_exporter"]
